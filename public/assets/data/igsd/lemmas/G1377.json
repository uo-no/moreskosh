 "senses": [
  {
   "id": "1",
   "label": "迫害する",
   "def": "人を追い立て、苦しめ、攻撃する。預言者・イエス・弟子・教会が迫害を受ける場面で現れ、受動で「迫害される」ともなる。",
   "note": "マタ5:10-12・44、ヨハ15:20、使9:4-5、使22:4、ロマ12:14、コリ一15:9、ガラ1:13、ガラ4:29、ピリ3:6、テモ二3:12。"
  },
  {
   "id": "2",
   "label": "追い求める",
   "def": "徳・平和・義・愛・目標など、善いものを目指して努力する。",
   "note": "ロマ9:30-31、ロマ12:13、ロマ14:19、コリ一14:1、ピリ3:12・14、テモ一6:11、ヘブ12:14、ペテ一3:11。"
  },
  {
   "id": "3",
   "label": "追いかける（人・場所を）",
   "def": "人を追って、ある場所へ行く。",
   "note": "ルカ17:23。"
  }
 ],
