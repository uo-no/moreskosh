 "senses": [
  {
   "id": "1",
   "label": "神の怒り（裁き）",
   "label_en": "God's wrath (judgment)",
   "def": "神（またキリスト）の怒り。終わりの日に現れる裁きとしての怒り、今すでに臨む怒りを含む。",
   "def_en": "The anger of God (and of Christ): wrath as judgment appearing on the last day, and wrath already coming now."
  },
  {
   "id": "2",
   "label": "人の怒り・憤り",
   "label_en": "human anger / indignation",
   "def": "人（イエスを含む）が抱く怒りの感情。",
   "def_en": "The emotion of anger felt by people (including Jesus)."
  },
  {
   "id": "3",
   "label": "為政者の怒り（処罰）",
   "label_en": "authorities' wrath (punishment)",
   "def": "為政者・権力者が悪を行う者に加える処罰、またそれを恐れる心。",
   "def_en": "The punishment that rulers and authorities inflict on wrongdoers, and the fear of it."
  }
 ],
