 "senses": [
  {
   "id": "1",
   "label": "泣く・涙を流す",
   "def": "声や涙をもって泣くこと。οἱ κλαίοντες ὡς μὴ κλαίοντες、ἔκλαυσεν πικρῶς、κλαίειν μετὰ κλαιόντων、μὴ κλαῖε など。"
  },
  {
   "id": "2",
   "label": "死を悼んで泣く・哀悼する",
   "def": "死者や死にゆく者を悼んで泣く場面。ヨハ11・20章の墓での涙、ルカ7:13・8:52、マタ2:18（ラケルが子らのために）、マコ5:38–39 など。"
  },
  {
   "id": "3",
   "label": "（悲しみ・悔い・裁き・滅びを）嘆く",
   "def": "悲嘆・悔い・裁きの予告・町や世の滅びなどを嘆く。κλαύσατε ὀλολύζοντες（ヤコ5:1）、πενθήσετε καὶ κλαύσετε、ἔκλαυσεν ἐπ᾽ αὐτήν（ルカ19:41）、黙18章の嘆きなど。"
  }
 ],
