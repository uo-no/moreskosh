{
 "lemma": "ἑτοιμάζω",
 "lemmaId": "grc:G2090",
 "strong": "G2090",
 "status": "draft",
 "updated": "2026-11-25",
 "senses": [
  {
   "id": "1",
   "label": "備える・用意する",
   "def": "食事・過越・場所・宿・武具など、必要なものを前もって用意する。τόπον ἑτοιμάσαι、τὸ πάσχα ἑτοιμάζειν、ἀρώματα ἡτοίμασαν、ξενίαν ἑτοίμαζε など。"
  },
  {
   "id": "2",
   "label": "（受動で）あらかじめ備えられている",
   "def": "受動（多くは完了分詞）で、あるもの・人・場所がすでに備えられている状態を述べる。ἡτοιμασμένην βασιλείαν、οἷς ἡτοίμασται、τόπον ἡτοιμασμένον、ἡτοιμασμένην ὡς νύμφην など。"
  },
  {
   "id": "3",
   "label": "（主のために）道・民を備える",
   "def": "ἑτοιμάσατε τὴν ὁδὸν κυρίου、ἑτοιμάσαι κυρίῳ λαὸν の形で、主の到来に向けて道や民を整える。"
  },
  {
   "id": "4",
   "label": "自分を整える（再帰）",
   "def": "ἑτοιμάζω ἑαυτόν の形で、自分自身が備えをする。"
  }
 ],
