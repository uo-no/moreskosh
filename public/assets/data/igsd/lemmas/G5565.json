 "status": "draft",
 "updated": "2026-11-24",
 "senses": [
  {
   "id": "1",
   "label": "〜なしに・〜を伴わずに",
   "def": "ある事柄・状態・人が、別のものを欠いたまま、あるいは関わらないままであることを述べる。χωρὶς νόμου・χωρὶς ἔργων・χωρὶς ἐμοῦ のように属格を伴う。"
  },
  {
   "id": "2",
   "label": "〜を除いて・〜は別にして",
   "def": "数える範囲から、ある者・ある事柄を外して述べる。χωρὶς γυναικῶν καὶ παιδίων（女と子どもを除いて）、χωρὶς τῶν παρεκτός（外のことは別にして）。"
  },
  {
   "id": "3",
   "label": "別に・離して（副詞的）",
   "def": "属格の対象を伴わず、ある物が他の物から離れた場所に置かれていることを述べる。ヨハ20:7 の χωρὶς ἐντετυλιγμένον。"
  }
 ],
