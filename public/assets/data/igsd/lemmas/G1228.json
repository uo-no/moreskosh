 "senses": [
  {
   "id": "1",
   "label": "悪魔",
   "def": "神に敵対し人を誘惑・告発する者を指す名詞。ὁ διάβολος（荒野の試みの主、世の終わりに縛られる者、ἀντίδικος ὑμῶν）、τὰ ἔργα τοῦ διαβόλου、τέκνα τοῦ διαβόλου、ὁ ἀρχαῖος ὄφις ὁ καλούμενος Διάβολος καὶ ὁ Σατανᾶς など。"
  },
  {
   "id": "2",
   "label": "中傷する（者）（形容詞）",
   "def": "形容詞・名詞として、人を中傷する・陰口をたたく者を指す。γυναῖκας σεμνὰς μὴ διαβόλους（1テモ3:11）、διάβολοι（2テモ3:3）、μὴ διαβόλους（テト2:3）。"
  }
 ],
