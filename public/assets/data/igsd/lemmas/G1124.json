{
 "lemma": "γραφή",
 "lemmaId": "grc:G1124",
 "strong": "G1124",
 "status": "draft",
 "updated": "2026-11-24",
 "senses": [
  {
   "id": "1",
   "label": "聖書（ἡ γραφή／αἱ γραφαί）",
   "def": "定冠詞をともなう ἡ γραφή・αἱ γραφαί として、書かれたもの＝聖書を指す。「聖書が言う」「聖書が成就する」「聖書を読む・調べる」の形で現れ、特定の箇所の引用と総称とのどちらにもなる。",
   "note": "マタ21:42、マタ26:54、ルカ24:27、ヨハ5:39、ヨハ7:38、使17:11、ロマ4:3、ロマ15:4、コリ一15:3-4、ガラ3:8、ヤコ2:23。"
  },
  {
   "id": "2",
   "label": "聖書の特定の箇所",
   "def": "指示詞・ἑτέρα・ἐν γραφῇ などで、聖書の一つの箇所を特定して指す用法。",
   "note": "マコ12:10（τὴν γραφὴν ταύτην）、ルカ4:21、ヨハ19:37（ἑτέρα γραφή）、使8:32・35、ペテ一2:6。"
  },
  {
   "id": "3",
   "label": "聖なる書き物（冠詞なし・形容語つき）",
   "def": "冠詞を伴わず、形容語をつけて「聖なる書き物」と述べる用法。",
   "note": "ロマ1:2（ἐν γραφαῖς ἁγίαις）。"
  }
 ],
