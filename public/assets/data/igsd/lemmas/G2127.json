{
 "lemma": "εὐλογέω",
 "lemmaId": "grc:G2127",
 "strong": "G2127",
 "status": "final",
 "updated": "2026-11-24",
 "senses": [
  {
   "id": "1",
   "label": "祝福する・祝福される",
   "label_en": "to bless / be blessed",
   "def": "人に祝福を宣し、あるいは恵みを授けること。また受身でその祝福を受けること。εὐλογεῖτε τοὺς διώκοντας、ὁ εὐλογήσας ἡμᾶς、εὐλογεῖσθαι など。"
  },
  {
   "id": "2",
   "label": "神をほめたたえる",
   "label_en": "to praise God",
   "def": "神を対象として、ほめたたえること。εὐλογῶν τὸν θεόν、εὐλογοῦμεν τὸν κύριον καὶ πατέρα。"
  },
  {
   "id": "3",
   "label": "祝福されている（εὐλογημένος）",
   "label_en": "blessed (εὐλογημένος)",
   "def": "受動完了分詞 εὐλογημένος／η／οι の形で、人・者について『祝福されている』と述べる・呼びかける形。「εὐλογημένος ὁ ἐρχόμενος ἐν ὀνόματι κυρίου」など。"
  },
  {
   "id": "4",
   "label": "食物・杯を祝福する",
   "label_en": "to bless food / the cup",
   "def": "パン・魚・杯を前にして εὐλογεῖν と述べられる用法。εὐλογήσας ἔκλασεν、τὸ ποτήριον ὃ εὐλογοῦμεν など。"
  }
 ],
