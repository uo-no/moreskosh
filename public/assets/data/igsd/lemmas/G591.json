{
 "lemma": "ἀποδίδωμι",
 "lemmaId": "grc:G591",
 "strong": "G591",
 "status": "draft",
 "updated": "2026-11-24",
 "senses": [
  {
   "id": "1",
   "label": "返す・支払う（負債・当然の分を）",
   "def": "借り・負債・賃金・納めるべきものなど、相手に当然渡すべきものを返す・支払う・納める。",
   "note": "マタ5:26、マタ18:25-34、マタ20:8、マタ22:21、ルカ7:42、ルカ10:35、ロマ13:7、コリ一7:3。"
  },
  {
   "id": "2",
   "label": "報いる・返報する",
   "def": "人の行いに応じて、報い・報酬・返礼を与える。善にも悪にも用いられる（「悪に悪を返す」）。",
   "note": "マタ6:4、マタ16:27、ロマ2:6、ロマ12:17、テサ一5:15、テモ二4:8、ペテ一3:9、黙22:12。"
  },
  {
   "id": "3",
   "label": "申し開きをする（λόγον ἀποδοῦναι）",
   "def": "λόγον とともに、行いや預かり物について説明・弁明・報告をする。",
   "note": "マタ12:36、ルカ16:2、使19:40、ヘブ13:17、ペテ一4:5。"
  },
  {
   "id": "4",
   "label": "手渡す・引き渡す",
   "def": "物や人を、元の持ち主・担当者へ渡す・戻す・引き渡す。",
   "note": "マタ27:58、ルカ4:20、ルカ9:42。"
  },
  {
   "id": "5",
   "label": "売る（中動）",
   "def": "中動相 ἀποδίδομαι で、物や人を売り渡す。",
   "note": "使5:8、使7:9、ヘブ12:16。"
  },
  {
   "id": "6",
   "label": "もたらす・与える（実り・証し）",
   "def": "実り・証しなどを生み出す・差し出す。",
   "note": "使4:33、ヘブ12:11、黙22:2。"
  }
 ],
