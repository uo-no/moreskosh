  {
   "id": "2",
   "label": "そしる・ののしる・中傷する",
   "label_en": "to slander / revile / insult",
   "label_es": "calumniar / injuriar / insultar",
   "def": "人（イエスを含む）、栄光ある存在、人の行い・教えについて、悪意をもって語る、侮辱する。",
   "def_en": "To speak maliciously of, or insult, a person (including Jesus), a glorious being, or a person's deeds or teaching."
  }
