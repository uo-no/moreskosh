{
 "lemma": "ἔρημος",
 "lemmaId": "grc:G2048",
 "strong": "G2048",
 "status": "draft",
 "updated": "2026-11-24",
 "senses": [
  {
   "id": "1",
   "label": "荒野（名詞的用法）",
   "def": "ἡ ἔρημος として、人の住まない広い野を指す名詞的用法。洗礼者の宣教、イエスの試み、イスラエルの荒野の旅などの場面で現れる。",
   "note": "マタ3:1、マタ4:1、マコ1:12-13、ルカ3:2、ヨハ6:31、使7:30-44、ヘブ3:8、黙12:6。"
  },
  {
   "id": "2",
   "label": "人けのない（場所を修飾）",
   "def": "τόπος などを修飾して、人気のない場所を述べる形容詞的用法。",
   "note": "マタ14:13、マコ1:35、マコ6:31-32、ルカ4:42、ルカ9:12。"
  },
  {
   "id": "3",
   "label": "荒れ果てた・住む者のない",
   "def": "家・住居・女などについて、荒れ果てて住む者のいない状態を述べる。",
   "note": "マタ23:38、使1:20、ガラ4:27。"
  }
 ],
