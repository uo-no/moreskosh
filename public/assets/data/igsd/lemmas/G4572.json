 "status": "draft",
 "updated": "2026-11-24",
 "senses": [
  {
   "id": "1",
   "label": "あなた自身を（直接の目的語）",
   "def": "二人称単数が、自分自身を動作の対象とする再帰代名詞（対格）。「自分を救え」「自分を示せ」「自分を清く保て」など。"
  },
  {
   "id": "2",
   "label": "あなた自身に・あなた自身のために（与格）",
   "def": "動作が自分自身に向かう、または自分のために行われることを示す与格。"
  },
  {
   "id": "3",
   "label": "あなた自身について・あなた自身のもとに（前置詞つき）",
   "def": "περί・ὑπέρ・ἀπό・παρά・κατά・μετά などの前置詞とともに用いられ、自分自身との関わりを述べる用法。"
  },
  {
   "id": "4",
   "label": "自分自身のように（隣人愛の戒め）",
   "def": "「あなたの隣人を自分自身のように愛しなさい」の定型表現 ὡς σεαυτόν。"
  }
 ],
