 "senses": [
  {
   "id": "1",
   "label": "今・いま",
   "label_en": "now / at present",
   "label_es": "ahora / al presente",
   "def": "話している時点（現在）を示す。「いま〜している」「今は〜」という時の副詞。",
   "def_en": "An adverb marking the present moment of speaking: \"now doing\", \"now is…\"."
  },
  {
   "id": "2",
   "label": "今から（ἀπ᾽ ἄρτι）",
   "label_en": "from now on (ἀπ᾽ ἄρτι)",
   "label_es": "de ahora en adelante (ἀπ᾽ ἄρτι)",
   "def": "ἀπ᾽ ἄρτι の形で、今この時点から先を指す。",
   "def_en": "In the form ἀπ᾽ ἄρτι, points forward from this moment onward."
  },
  {
   "id": "3",
   "label": "今に至るまで（ἕως ἄρτι ほか）",
   "label_en": "until now (ἕως ἄρτι, etc.)",
   "label_es": "hasta ahora (ἕως ἄρτι, etc.)",
   "def": "ἕως ἄρτι、ἄχρι τῆς ἄρτι ὥρας の形で、過去から今までの継続を示す。",
   "def_en": "In the forms ἕως ἄρτι and ἄχρι τῆς ἄρτι ὥρας, marks continuation from the past up to now."
  },
  {
   "id": "4",
   "label": "たった今・ちょうど",
   "label_en": "just now / right now",
   "label_es": "ahora mismo / hace un momento",
   "def": "ついさっき起きたばかりのことを示す。",
   "def_en": "Marks something that has only just happened."
  }
 ],
