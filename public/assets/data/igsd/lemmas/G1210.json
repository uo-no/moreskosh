 "senses": [
  {
   "id": "1",
   "label": "縛る・つなぐ（物・動物・遺体）",
   "def": "ひもや布で、物・動物・束・遺体などを縛り、つなぐ。「ろばがつながれている」「毒麦を束ねる」「亜麻布で巻く」など。"
  },
  {
   "id": "2",
   "label": "人を縛る・捕らえる",
   "def": "人を縄・鎖などで縛って拘束する。逮捕・連行・投獄される場面で現れる用法。"
  },
  {
   "id": "3",
   "label": "義務・約束で縛られる",
   "def": "人が法・結婚・霊の導きなどに縛られ、拘束されていること。"
  },
  {
   "id": "4",
   "label": "超自然的な存在を縛る",
   "def": "悪霊・サタン・天使など、人間を超える存在を縛ること、またその状態。"
  },
  {
   "id": "5",
   "label": "縛る（天で縛られる）",
   "def": "「地で縛るものは天でも縛られている」という、縛ると解くの対で述べられる用法。"
  }
 ],
