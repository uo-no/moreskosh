 "senses": [
  {
   "id": "1",
   "label": "報告する・知らせる",
   "def": "出来事や見聞きしたことを、ある人に向けて伝え報せる。使者や目撃者が、見たこと・起こったことを報告する用例が大半を占める。"
  },
  {
   "id": "2",
   "label": "宣べ知らせる・告げ知らせる",
   "def": "事柄・教え・主の名などを、公に、または聞き手に向けて告げ知らせる。報告よりも、内容そのものを宣言する性格が強い用例。"
  }
 ],
