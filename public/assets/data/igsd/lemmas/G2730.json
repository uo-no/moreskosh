 "updated": "2026-11-24",
 "senses": [
  {
   "id": "1",
   "label": "住む・住みつく",
   "label_en": "to dwell / settle",
   "label_es": "habitar / establecerse",
   "def": "人や霊が、ある場所に居を定めて住む。「ナザレに住んだ」「悪霊が入りこんで住みつく」「サタンの住むところ」など。",
   "def_en": "A person or spirit takes up residence in a place: \"settled in Nazareth\", \"an evil spirit enters and settles\", \"where Satan lives\", etc."
  },
  {
   "id": "2",
   "label": "住民（〜に住む者）",
   "label_en": "inhabitant (one who lives in)",
   "label_es": "habitante (el que vive en)",
   "def": "分詞で「〜に住む人々」と、ある土地・町の住民を述べる用法。「エルサレムに住む人々」「地に住む者たち」など。",
   "def_en": "With a participle, \"those living in…\": the inhabitants of a land or town: \"those living in Jerusalem\", \"those who dwell on the earth\"."
  },
  {
   "id": "3",
   "label": "宿る・住まわれる",
   "label_en": "to dwell in / indwell",
   "label_es": "morar en / habitar en",
   "def": "神・キリスト・神性の満ち満ちたものなどが、ある場所や人の内に宿り、住まわれる。",
   "def_en": "God, Christ, the fullness of deity, and the like take up residence in a place or person and dwell there."
  }
 ],
 "idioms": [
  {
