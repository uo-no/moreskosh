{
 "lemma": "οὐαί",
 "lemmaId": "grc:G3759",
 "strong": "G3759",
 "status": "draft",
 "updated": "2026-11-24",
 "senses": [
  {
   "id": "1",
   "label": "災いあれ（宣告）",
   "def": "与格や対格の相手に対して「災いあれ」と宣告する感嘆詞。οὐαί σοι／ὑμῖν の形で、叱責・裁きの言葉として現れる。",
   "note": "マタ11:21、マタ18:7、マタ23:13-29、ルカ6:24-26、ルカ11:42-52、コリ一9:16、ユダ11、黙8:13、黙12:12。"
  },
  {
   "id": "2",
   "label": "嘆き・憐れみの叫び",
   "def": "悲しみ・同情・嘆きを表す叫びとして用いられる。妊婦への言葉（οὐαὶ ταῖς ἐν γαστρὶ ἐχούσαις）や、黙18章のバビロンの崩壊を嘆く οὐαὶ οὐαί。",
   "note": "マタ24:19、マコ13:17、ルカ21:23、黙18:10・16・19。"
  },
  {
   "id": "3",
   "label": "災い（名詞・出来事）",
   "def": "冠詞を伴い、到来する出来事としての「災い」を数える用法。",
   "note": "黙9:12、黙11:14。"
  }
 ],
