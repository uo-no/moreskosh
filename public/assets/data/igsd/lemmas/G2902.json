 "senses": [
  {
   "id": "1",
   "label": "捕らえる・逮捕する",
   "def": "人を捕らえて拘束する。ἐκράτησαν αὐτόν の形で、逮捕の場面（ヨハネの捕縛・イエスの逮捕・使徒の拘束）に現れる。",
   "note": "マタ14:3、マタ21:46、マタ26:48・50・55・57、マコ3:21、マコ12:12、マコ14:1・44・46、使24:6、黙20:2。"
  },
  {
   "id": "2",
   "label": "（手・足などを）つかむ・握る",
   "def": "手・足などをつかんで握る、持つ。癒しや起こす場面での「手をとる」を含む。",
   "note": "マタ9:25、マタ28:9、マコ1:31、マコ5:41、マコ9:27、ルカ8:54、使3:11、黙2:1。"
  },
  {
   "id": "3",
   "label": "固く保つ・守る",
   "def": "教え・伝承・告白・名などを手放さずに保持する。",
   "note": "マコ7:3-4・8、テサ二2:15、ヘブ4:14、ヘブ6:18、コロ2:19、黙2:13-15、黙2:25、黙3:11。"
  },
  {
   "id": "4",
   "label": "とどめる・抑える",
   "def": "動き・働きを押さえて自由にさせない（目がとどめられる、死に捕らえられる、風を押さえる、罪をとどめる）。",
   "note": "マコ9:10、ルカ24:16、ヨハ20:23、使2:24、黙7:1。"
  }
 ],
