 "senses": [
  {
   "id": "1",
   "label": "第二の（順序）",
   "def": "順序や列挙の中で、一番目の次に来るもの。「第二の人」「第二の戒め」「第二の幕屋」「二番目の天使」など。"
  },
  {
   "id": "2",
   "label": "二度目に・再び（回数）",
   "def": "同じことがもう一度起こること。ἐκ δευτέρου や τὸ δεύτερον の形で、「二度目に」「再び」と回数を述べる副詞的用法。"
  },
  {
   "id": "3",
   "label": "第二の死",
   "def": "「第二の死」という定型表現。黙示録で、火の池に投げ込まれることを指して用いられる。"
  }
 ],
