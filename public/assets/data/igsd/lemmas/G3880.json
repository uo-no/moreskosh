{
 "lemma": "παραλαμβάνω",
 "lemmaId": "grc:G3880",
 "strong": "G3880",
 "status": "final",
 "updated": "2026-11-24",
 "senses": [
  {
   "id": "1",
   "label": "連れて行く・伴う",
   "label_en": "to take along / accompany",
   "def": "人を自分のもとへ、あるいは自分に伴って連れて行く。同行させる・連れ出す・拘束して引き取る場合を含む。受動で「連れて行かれる」ともなる。",
   "def_en": "To take a person to oneself or along with oneself. Includes having someone accompany, taking them out, and taking them into custody. In the passive, \"to be taken along\".",
   "note": "マタ2:13、マタ4:5、マタ17:1、マコ5:40、ルカ9:28、使16:33、ヨハ14:3、ヨハ19:16。"
  },
  {
   "id": "2",
   "label": "迎え入れる",
   "label_en": "to take in / receive",
   "def": "人を自分のもとに受け入れる・引き取る。",
   "def_en": "To receive and take in a person to oneself.",
   "note": "マタ1:20（παραλαβεῖν Μαρίαν τὴν γυναῖκά σου）、マタ1:24、ヨハ1:11。"
  },
  {
   "id": "3",
   "label": "受け取る（伝えられたものを）",
   "label_en": "to receive (what was handed down)",
   "def": "教え・伝承・務め・国など、他から手渡されたものを受け取る。παραδίδωμι（伝える）と対になる。",
   "def_en": "To receive what has been handed on by another: teaching, tradition, a ministry, a kingdom. Paired with παραδίδωμι (to hand on).",
   "note": "マコ7:4、コリ一11:23、コリ一15:1・3、ガラ1:9・12、コロ2:6、テサ一2:13、テサ二3:6、ヘブ12:28。"
  }
 ],
