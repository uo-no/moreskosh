 "senses": [
  {
   "id": "1",
   "label": "驚く・驚嘆する",
   "label_en": "to be amazed / marvel",
   "def": "目にしたこと・聞いたことに驚き、感嘆する。群衆・弟子たち・イエスなどが驚く最も典型的な用例。"
  },
  {
   "id": "2",
   "label": "感嘆する・称賛する",
   "label_en": "to admire / praise",
   "def": "人や力あるものに感嘆して、敬服・賛美の念を抱く。驚きの対象に向けた、称賛の色合いを持つ用法。"
  },
  {
   "id": "3",
   "label": "意外に思う・不審に思う",
   "label_en": "to be surprised / find strange",
   "def": "予想と違うことに驚き、いぶかる。「驚くな」と戒めたり、「驚いている」と非難したりする用法。"
  }
 ],
