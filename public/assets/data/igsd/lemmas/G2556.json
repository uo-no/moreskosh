 "status": "final",
 "updated": "2026-11-24",
 "senses": [
  {
   "id": "1",
   "label": "悪い・邪悪な",
   "label_en": "bad / evil",
   "def": "名詞を修飾する、あるいは述語として述べられる、性質としての悪さ・邪悪さ。人・考え・行い・物事について用いられる。",
   "note": "マタ24:48（κακὸς δοῦλος）、マコ7:21（διαλογισμοὶ οἱ κακοί）、ピリ3:2（κακοὺς ἐργάτας）、黙2:2、黙16:2（ἕλκος κακόν）。"
  },
  {
   "id": "2",
   "label": "悪・悪事（名詞的用法）",
   "label_en": "evil / wrongdoing (noun)",
   "def": "中性（τὸ κακόν／κακά）や κακοῦ 等の名詞的用法で、道徳的な悪・悪い行い・悪い事柄そのものを指す。善（ἀγαθόν／καλόν）と対比されることが多い。",
   "note": "ロマ7:19、ロマ12:17・21、ロマ13:3-4、ヘブ5:14、ペテ一3:9-11、ヨハ三11、マコ15:14（τί κακὸν ἐποίησεν）。"
  },
  {
   "id": "3",
   "label": "害・災い",
   "label_en": "harm / calamity",
   "def": "他者に加えられる損害・危害、あるいは身に降りかかる不幸・災難として現れる悪。",
   "note": "ルカ16:25（τὰ κακά）、使9:13、使16:28、使28:5、ロマ13:10、テモ二4:14。"
  }
 ],
