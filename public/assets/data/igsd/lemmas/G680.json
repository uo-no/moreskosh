{
 "lemma": "ἅπτω",
 "lemmaId": "grc:G680",
 "strong": "G680",
 "status": "draft",
 "updated": "2026-11-25",
 "senses": [
  {
   "id": "1",
   "label": "触れる",
   "def": "手などで物や人に触れる（中動 ἅπτομαι）。イエスが触れて癒す、衣のふさに触れる、子どもたちに触れてもらう、など。"
  },
  {
   "id": "2",
   "label": "手を出す・関わる",
   "def": "禁じられたもの・汚れたものに手を出す、あるいは人に害を及ぼす、また異性に触れる（婉曲）。ἀκαθάρτου μὴ ἅπτεσθε、μὴ ἅψῃ μηδὲ γεύσῃ、οὐχ ἅπτεται αὐτοῦ（悪い者が彼に触れない）、γυναικὸς μὴ ἅπτεσθαι。"
  },
  {
   "id": "3",
   "label": "火をともす（能動 ἅπτω）",
   "def": "ともしび・火をつける。λύχνον ἅψας、ἅπτει λύχνον、ἅψαντες πυράν。"
  }
 ],
