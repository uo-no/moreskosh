{
 "lemma": "πρόβατον",
 "lemmaId": "grc:G4263",
 "strong": "G4263",
 "status": "draft",
 "updated": "2026-11-25",
 "senses": [
  {
   "id": "1",
   "label": "羊（動物として）",
   "def": "動物としての羊。πρόβατα καὶ βόες（神殿の商人）、穴に落ちた羊（安息日）、百匹の羊を持つ人の譬え、ἐν ἐνδύμασι προβάτων（羊の皮）、黙示録の商品の羊など。"
  },
  {
   "id": "2",
   "label": "羊（民・弟子・信者を指す比喩）",
   "def": "羊飼いと羊の像で、神の民・イエスの弟子・信じる者たち・イスラエルを指す。τὰ πρόβατά μου（ヨハ10・21章）、τὰ πρόβατα τὰ ἀπολωλότα οἴκου Ἰσραήλ、羊と山羊の分離、羊が散らされる、ポイメーンと羊など。"
  },
  {
   "id": "3",
   "label": "ὡς πρόβατα（羊のように）",
   "def": "ὡς πρόβατα の比較の形で、人が羊にたとえられる。ὡς πρόβατα ἐν μέσῳ λύκων、ὡς πρόβατα μὴ ἔχοντα ποιμένα、ὡς πρόβατον ἐπὶ σφαγήν など。"
  }
 ],
