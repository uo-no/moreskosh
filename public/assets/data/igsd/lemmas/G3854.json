{
 "lemma": "παραγίνομαι",
 "lemmaId": "grc:G3854",
 "strong": "G3854",
 "status": "final",
 "updated": "2026-11-25",
 "senses": [
  {
   "id": "1",
   "label": "来る・到着する・居合わせる",
   "def": "ある場所に来る、到着する、その場に着く。παρεγένοντο εἰς Ἀντιόχειαν、παραγενόμενος εἰς Ἱεροσόλυμα、παραγίνεται Ἰούδας、οἱ παραγενόμενοι ὑπηρέται など。"
  },
  {
   "id": "2",
   "label": "（使命を帯びて）現れる・来る",
   "def": "人が使命のために公の場に現れる。παραγίνεται Ἰωάννης ὁ βαπτιστής（マタ3:1）、Χριστὸς παραγενόμενος ἀρχιερεύς（ヘブ9:11）、εἰρήνην παρεγενόμην δοῦναι（ルカ12:51）。"
  },
  {
   "id": "3",
   "label": "そばについて支える",
   "def": "裁判の場でそばについて支える。οὐδείς μοι παρεγένετο（2テモ4:16）。"
  }
 ],
