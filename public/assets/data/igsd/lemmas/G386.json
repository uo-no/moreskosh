{
 "lemma": "ἀνάστασις",
 "lemmaId": "grc:G386",
 "strong": "G386",
 "status": "final",
 "updated": "2026-11-24",
 "senses": [
  {
   "id": "1",
   "label": "復活（死者のよみがえり）",
   "label_en": "resurrection (raising of the dead)",
   "def": "死者が生き返ること。ἀνάστασις νεκρῶν（死者の復活）、ἐν τῇ ἀναστάσει（復活のとき）、ἀνάστασις ζωῆς／κρίσεως、ἡ ἀνάστασις ἡ πρώτη など。"
  },
  {
   "id": "2",
   "label": "イエス・キリストの復活",
   "label_en": "resurrection of Jesus Christ",
   "def": "属格や文脈で、イエス・キリスト（主）の復活であることが明示される用法。ἀνάστασις Ἰησοῦ Χριστοῦ、ἀνάστασις τοῦ κυρίου Ἰησοῦ、ἀνάστασις αὐτοῦ など。",
   "note": "使17:18 では、アテネの聴衆に女神の名と聞こえた可能性がある（BDAG 語義3）。"
  },
  {
   "id": "3",
   "label": "起き上がること",
   "label_en": "rising up",
   "def": "ルカ2:34 の πτῶσιν καὶ ἀνάστασιν πολλῶν で、『倒れること』に対して『立ち上がること』を述べる。"
  }
 ],
