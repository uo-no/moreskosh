 "senses": [
  {
   "id": "1",
   "label": "敬意・尊重",
   "label_en": "respect / honor",
   "def": "人に対して払う敬い・尊重。πάσης τιμῆς ἀξίους、ἀπονέμοντες τιμήν、τιμὴν περισσοτέραν、τῷ τὴν τιμὴν τὴν τιμήν（ロマ13:7）など。"
  },
  {
   "id": "2",
   "label": "誉れ・栄誉",
   "label_en": "honor / glory",
   "def": "δόξα（栄光）、δύναμις（力）などと並べて述べられる誉れ・栄誉。δόξα καὶ τιμή、ἡ εὐλογία καὶ ἡ τιμή、τιμὴ καὶ κράτος など。"
  },
  {
   "id": "3",
   "label": "値・代価・代金",
   "label_en": "price / value / payment",
   "def": "物や土地の値、売って得た代金、買い取りの代価。τιμὴ αἵματος、ἀπὸ τῆς τιμῆς τοῦ χωρίου、τιμῆς ἠγοράσθητε など。"
  },
  {
   "id": "4",
   "label": "尊い用途（εἰς τιμήν）",
   "label_en": "honorable use (εἰς τιμήν)",
   "def": "σκεῦος εἰς τιμήν／εἰς ἀτιμίαν の形で、器の用途が尊いか卑しいかの対で用いられる。"
  },
  {
   "id": "5",
   "label": "報酬・謝礼",
   "label_en": "fee / payment",
   "def": "働きに対して支払われる報酬・謝礼。Ⅰテモ5:17 のみ（長老への『二重の』報酬）。"
  }
 ],
