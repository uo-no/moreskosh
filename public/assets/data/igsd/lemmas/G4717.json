{
 "lemma": "σταυρόω",
 "lemmaId": "grc:G4717",
 "strong": "G4717",
 "status": "draft",
 "updated": "2026-11-24",
 "senses": [
  {
   "id": "1",
   "label": "十字架につける",
   "def": "人を十字架にかけて処刑する。イエス、また共に処刑された者について、能動・受動・命令（Σταύρωσον）の形で現れる。",
   "note": "マタ20:19、マタ27:22-35、マコ15:13-25、ルカ23:21-33、ヨハ19:6-41、使2:36、使4:10、コリ一1:13、コリ二13:4、黙11:8。"
  },
  {
   "id": "2",
   "label": "十字架につけられた方（ἐσταυρωμένος）",
   "def": "完了分詞で、「十字架につけられた者」として名指す・宣べ伝える用法。",
   "note": "マタ28:5、マコ16:6、コリ一1:23、コリ一2:2、ガラ3:1。"
  },
  {
   "id": "3",
   "label": "十字架につけられる（比喩的）",
   "def": "肉・世など、人にとっての対象が「十字架につけられる」と述べる比喩的用法。",
   "note": "ガラ5:24、ガラ6:14。"
  }
 ],
