{
 "lemma": "ἐπιγινώσκω",
 "lemmaId": "grc:G1921",
 "strong": "G1921",
 "status": "final",
 "updated": "2026-11-24",
 "senses": [
  {
   "id": "1",
   "label": "見分ける・それと分かる",
   "label_en": "to discern / recognize",
   "def": "人や物を、見て・聞いて、それが誰・何であるかと識別する。見覚えのあるものを見分ける用例。"
  },
  {
   "id": "2",
   "label": "気づく・悟る",
   "label_en": "to notice / realize",
   "def": "出来事・状況・相手の考えなどに、見てまたは知らされて気づく。直前の観察や情報から、事実を悟る用例。"
  },
  {
   "id": "3",
   "label": "よく知る・知識に至る",
   "label_en": "to know fully / come to knowledge",
   "def": "対象（真理・神の恵み・人など）を、はっきりと確かに知る。「知る」（γινώσκω）の上に、完全さ・確かさが加わる用例。"
  },
  {
   "id": "4",
   "label": "調べて確かめる",
   "label_en": "to examine and ascertain",
   "def": "事情・理由・事実を、尋問や調査によって明らかにする。"
  },
  {
   "id": "5",
   "label": "認める・承認する",
   "label_en": "to acknowledge / recognize",
   "def": "人や教えを、受け入れるべきものとして認める。"
  }
 ],
