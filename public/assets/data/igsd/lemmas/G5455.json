 "status": "draft",
 "updated": "2026-11-24",
 "senses": [
  {
   "id": "1",
   "label": "呼ぶ・呼び寄せる・招く",
   "def": "人を自分のもとへ呼び寄せる、または招く。「弟子たちを呼ぶ」「夫を呼んで来なさい」「僕たちを呼ぶ」など。"
  },
  {
   "id": "2",
   "label": "（鶏が）鳴く",
   "def": "鶏が鳴くこと。ペテロの否認の予告と成就の場面で、「鶏が鳴く前に」と述べられる。"
  },
  {
   "id": "3",
   "label": "声を上げる・呼びかける",
   "def": "大声で叫ぶ、または声に出して呼びかける。呼び寄せることよりも、声を発することに重心がある用例。"
  },
  {
   "id": "4",
   "label": "（名・称号で）呼ぶ",
   "def": "人をある名や称号で呼ぶ。「先生」と呼ぶという用例。"
  }
 ],
