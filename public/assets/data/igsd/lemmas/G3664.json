{
 "lemma": "ὅμοιος",
 "lemmaId": "grc:G3664",
 "strong": "G3664",
 "status": "final",
 "updated": "2026-11-24",
 "senses": [
  {
   "id": "1",
   "label": "同じ性質の・似ている",
   "def": "あるものと性質・あり方・種類が同じであること。ὅμοιος τινι の形で、比べられる対象と同類であることを述べる。"
  },
  {
   "id": "2",
   "label": "譬えの導入（〜に似ている）",
   "def": "「天の国は〜に似ている」「〜は…のような人である」と、譬えを導く定型的な用法。"
  },
  {
   "id": "3",
   "label": "比類を問う（誰が〜に等しいか）",
   "def": "「誰が〜に似ているか」と、並ぶもののなさを修辞的に問う用法。"
  },
  {
   "id": "4",
   "label": "見た目が似ている（幻視の描写）",
   "def": "幻の中で見たものの形・色・姿を、既知のものに似ているとして描く用法（黙示録に集中する）。"
  }
 ],
