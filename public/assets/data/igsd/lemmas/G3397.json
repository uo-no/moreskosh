{
 "lemma": "μικρός",
 "lemmaId": "grc:G3397",
 "strong": "G3397",
 "status": "final",
 "updated": "2026-11-24",
 "senses": [
  {
   "id": "1",
   "label": "小さい・わずかな",
   "def": "大きさ・量・程度が小さいこと。ζύμη・μέλος・ποίμνιον・δύναμις などを修飾し、またμικρόν τι の形で「少し」を述べる。",
   "note": "マタ13:32、マコ4:31、ルカ12:32、ルカ19:3、コリ一5:6、コリ二11:1、ガラ5:9、ヤコ3:5、黙3:8。"
  },
  {
   "id": "2",
   "label": "小さい者・身分の低い者",
   "def": "人の地位・重要さについて「小さい者」を指す。τῶν μικρῶν τούτων の形、また μεγάλος と対にされる「小さい者も大きい者も」の用法を含む。",
   "note": "マタ10:42、マタ11:11、マタ18:6・10・14、ルカ7:28、ルカ9:48、使8:10、ヘブ8:11、黙11:18、黙13:16、黙19:5。"
  },
  {
   "id": "3",
   "label": "しばらく・わずかの間",
   "def": "μικρόν を副詞的・名詞的に用い、短い時間・間もなくを述べる。ἔτι μικρόν、μετὰ μικρόν、μικρὸν χρόνον の形で現れる。",
   "note": "マタ26:73、ヨハ7:33、ヨハ13:33、ヨハ14:19、ヨハ16:16-19、ヘブ10:37、黙6:11、黙20:3。"
  },
  {
   "id": "4",
   "label": "少し先へ（距離）",
   "def": "προελθών とともに、少しだけ先へ進むことを述べる。",
   "note": "マタ26:39、マコ14:35。"
  }
 ],
