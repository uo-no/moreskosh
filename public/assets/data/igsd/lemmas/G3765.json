{
 "lemma": "οὐκέτι",
 "lemmaId": "grc:G3765",
 "strong": "G3765",
 "status": "final",
 "updated": "2026-11-24",
 "senses": [
  {
   "id": "1",
   "label": "もはや〜ない",
   "label_en": "no longer",
   "def": "それまで続いていたこと・成り立っていたことが、ある時点以後は成り立たなくなる。時間的な終結。",
   "def_en": "What had continued or held until then no longer holds from a certain point on. A temporal ending.",
   "note": "マタ19:6、マコ9:8、ヨハ6:66、ヨハ15:15、使20:25、ロマ6:9、ガラ2:20、ガラ4:7、エペ2:19、黙10:6。"
  },
  {
   "id": "2",
   "label": "〜ならば、もはや〜でない（論理的帰結）",
   "label_en": "if so, no longer (logical consequence)",
   "def": "条件・前提を述べたうえで、それなら「もはや〜ではあり得ない」と結論する用法。",
   "def_en": "After stating a condition or premise, concludes that in that case it can \"no longer be…\".",
   "note": "ロマ11:6、ロマ14:15、ガラ3:18、ヘブ10:18。"
  }
 ],
