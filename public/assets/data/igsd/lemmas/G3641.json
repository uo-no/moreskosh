{
 "lemma": "ὀλίγος",
 "lemmaId": "grc:G3641",
 "strong": "G3641",
 "status": "final",
 "updated": "2026-11-25",
 "senses": [
  {
   "id": "1",
   "label": "少ない・わずかな（数・量）",
   "label_en": "few / small (number / amount)",
   "def": "数や量が少ないこと。οἱ ἐργάται ὀλίγοι（働き手は少ない）、ὀλίγοι οἱ σῳζόμενοι、ὀλίγα ἰχθύδια、οἴνῳ ὀλίγῳ（少しのぶどう酒）など。形容詞用法のほか、名詞的（ὀλίγοι「少数の者」・ὀλίγα「わずかなこと」）にも用いる。"
  },
  {
   "id": "2",
   "label": "しばらく・短い間（時間）",
   "label_en": "a short while (time)",
   "def": "ὀλίγον（副詞・対格）や πρὸς ὀλίγον、πρὸς ὀλίγας ἡμέρας の形で、時間が短いことを述べる。"
  },
  {
   "id": "3",
   "label": "少し・わずか（距離・程度）",
   "label_en": "a little / slight (distance / degree)",
   "def": "ὀλίγον が「少しだけ（先へ）」「少ししか〜しない」のように、距離や程度の小ささを述べる。"
  },
  {
   "id": "4",
   "label": "少なくない・かなりの（οὐκ ὀλίγος）",
   "label_en": "not a few / considerable (οὐκ ὀλίγος)",
   "def": "οὐκ ὀλίγος の否定形で、「少なくない」すなわち「かなりの数・量・程度」を述べる（緩叙法）。"
  },
  {
   "id": "5",
   "label": "手短に（ἐν ὀλίγῳ／δι᾽ ὀλίγων）",
   "label_en": "briefly (ἐν ὀλίγῳ / δι᾽ ὀλίγων)",
   "def": "ἐν ὀλίγῳ、δι᾽ ὀλίγων の形で、言葉数を少なくして述べる（手紙の記述の仕方）。"
  }
 ],
