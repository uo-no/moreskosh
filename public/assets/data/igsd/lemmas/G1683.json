 "senses": [
  {
   "id": "1",
   "label": "わたし自身（再帰）",
   "def": "一人称の再帰代名詞。ἐμαυτὸν ἐδούλωσα、περὶ ἐμαυτοῦ μαρτυρῶ、οὐδὲν ἐμαυτῷ σύνοιδα、πρὸς ἐμαυτὸν（わたしのもとへ）など、主語自身を指す。"
  },
  {
   "id": "2",
   "label": "ἀπ᾽／ἐξ ἐμαυτοῦ（自分の側から・勝手に）",
   "def": "ἀπ᾽ ἐμαυτοῦ／ἐξ ἐμαυτοῦ の形で、自分一人の判断・権威で行う、あるいは行わないことを述べる（ヨハネ福音書）。"
  }
 ],
