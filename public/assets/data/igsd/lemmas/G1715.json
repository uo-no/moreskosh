 "status": "draft",
 "updated": "2026-11-24",
 "senses": [
  {
   "id": "1",
   "label": "〜の前で・面前で",
   "def": "人・神・法廷などの目の前、また証人・聞き手・審き手のいる所で、ということを述べる前置詞（属格支配）。告白・否認・栄光・裁きの場面で現れる。",
   "note": "マタ5:16、マタ10:32-33、マタ26:70、マタ27:11、ルカ12:8、使10:4、コリ二5:10、テサ一1:3、ヨハ一3:19。"
  },
  {
   "id": "2",
   "label": "〜の前に（空間的位置・方向）",
   "def": "物理的な位置として「前に」「前方に」を述べる前置詞（属格支配）。",
   "note": "マタ5:24、マタ7:6、マタ11:10、ヨハ10:4、ルカ14:2、使18:17、黙19:10。"
  },
  {
   "id": "3",
   "label": "前方に・先に（副詞的用法）",
   "def": "属格を伴わず、副詞として「前方に」「前の方へ」を述べる。",
   "note": "ルカ19:4（εἰς τὸ ἔμπροσθεν）、ルカ19:28、ピリ3:13、黙4:6。"
  }
 ],
