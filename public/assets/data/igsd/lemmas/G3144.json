 "senses": [
  {
   "id": "1",
   "label": "証人（法廷・立証の証人）",
   "label_en": "witness (in court / proving a case)",
   "def": "出来事や言葉の真実性を立証するために立てられる証人。「二人または三人の証人の口によって」など。"
  },
  {
   "id": "2",
   "label": "証人（見たこと・知ったことを証言する者）",
   "label_en": "witness (one who testifies to what he saw or knew)",
   "def": "見聞きした出来事（イエスの復活・業・苦難）の目撃者・証言者としての証人。"
  },
  {
   "id": "3",
   "label": "殉教者（死に至るまで証言した者）",
   "label_en": "martyr (one who bore witness unto death)",
   "def": "証言のゆえに殺された者。"
  },
  {
   "id": "4",
   "label": "証人としての神（人）",
   "label_en": "God (a person) as witness",
   "def": "自分の言葉・思いが真実であることの証人として、神（や聞き手）を呼ぶ表現。"
  }
 ],
