 "senses": [
  {
   "id": "1",
   "label": "義と認める・義とされる",
   "label_en": "to count as righteous / be justified",
   "def": "神が人を義と宣告する、またその宣告を受けて義とされること。信仰・律法の行い・キリストの血・恵みとの関係で語られる。"
  },
  {
   "id": "2",
   "label": "正しいと認める・正しさが示される",
   "label_en": "to recognize as right / be shown to be right",
   "def": "人が神や知恵を正しいとして認める、人が自分を正しく見せようとする、または神・知恵の正しさが（語られた言葉や行いによって）明らかにされること。"
  }
