{
 "lemma": "φόβος",
 "lemmaId": "grc:G5401",
 "strong": "G5401",
 "status": "final",
 "updated": "2026-11-24",
 "senses": [
  {
   "id": "1",
   "label": "恐れ・恐怖",
   "label_en": "fear / terror",
   "def": "脅威・危険・驚きなどに対して人が抱く恐れ、またその恐れに駆られている状態。ἀπὸ τοῦ φόβου・διὰ τὸν φόβον τῶν Ἰουδαίων のように原因として示される場合を含む。",
   "note": "マタ14:26、マタ28:4、ヨハ7:13、ヨハ20:19、ロマ8:15、ヘブ2:15、ヨハ一4:18、黙18:10。"
  },
  {
   "id": "2",
   "label": "畏れ（神・主への）",
   "label_en": "reverent fear (of God / the Lord)",
   "def": "神・主・キリストを対象とする畏れ。φόβος θεοῦ／κυρίου／Χριστοῦ の形、あるいは ἐν φόβῳ として現れる。",
   "note": "使9:31、ロマ3:18、コリ二5:11、コリ二7:1、エペ5:21、ペテ一1:17。"
  },
  {
   "id": "3",
   "label": "畏怖（出来事に際して臨む畏れ）",
   "label_en": "awe (coming upon people at an event)",
   "def": "神の働き・奇跡・裁きなどの出来事に際し、周囲の人々の上に臨む畏れ。ἐγένετο／ἐπέπεσεν φόβος（μέγας）の形で現れる。",
   "note": "ルカ1:65、ルカ5:26、ルカ7:16、使2:43、使5:5・11、使19:17、黙11:11。"
  },
  {
   "id": "4",
   "label": "敬意・尊敬",
   "label_en": "respect / honor",
   "def": "ロマ13:7 で、τιμή と並べて、相手に払うべき敬意として述べられる。",
   "note": "ロマ13:7（τῷ τὸν φόβον τὸν φόβον）。"
  }
 ],
