 "senses": [
  {
   "id": "1",
   "label": "四つ・四人",
   "def": "基数詞「四」。τέσσαρα ζῷα、τέσσαρες ἄγγελοι、τέσσαρες ἄνεμοι／γωνίαι、τέσσαρας ἡμέρας など、名詞に添えて数を述べる。"
  },
  {
   "id": "2",
   "label": "合成数の一部（二十四・八十四・百四十四など）",
   "def": "εἴκοσι τέσσαρες（二十四）、ὀγδοήκοντα τέσσαρες（八十四）、ἑκατὸν τεσσεράκοντα τέσσαρες（百四十四）のように、他の数詞と組み合わされて大きな数をなす。"
  }
 ],
