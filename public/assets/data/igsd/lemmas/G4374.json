{
 "lemma": "προσφέρω",
 "lemmaId": "grc:G4374",
 "strong": "G4374",
 "status": "final",
 "updated": "2026-11-24",
 "senses": [
  {
   "id": "1",
   "label": "連れて来る・差し出す（人を）",
   "label_en": "to bring / present (a person)",
   "label_es": "traer / presentar (una persona)",
   "def": "病人・子ども・被告などの人を、人のもとへ連れて来る・差し出す。",
   "def_en": "To bring or present a person (sick people, children, accused) to someone.",
   "note": "マタ4:24、マタ8:16、マタ9:2、マタ14:35、マタ19:13、マコ2:4、マコ10:13、ルカ18:15、ルカ23:14。"
  },
  {
   "id": "2",
   "label": "差し出す（物を）",
   "label_en": "to bring / present (a thing)",
   "label_es": "traer / presentar (una cosa)",
   "def": "贈り物・金銭・飲み物などの物を、人に差し出す・持って来る。",
   "def_en": "To bring or present to someone things such as gifts, money, and drink.",
   "note": "マタ2:11、マタ22:19、マタ25:20、ルカ23:36、ヨハ19:29、使8:18。"
  },
  {
   "id": "3",
   "label": "献げる（神に）",
   "label_en": "to offer (to God)",
   "label_es": "ofrecer (a Dios)",
   "def": "供え物・いけにえ・祈り・自身を、神に献げる。レビ的な献げ物（δῶρα καὶ θυσίαι）に関する語で、ヘブライ書に集中する。",
   "def_en": "To offer to God sacrifices, prayers, or oneself. A word for Levitical offerings (δῶρα καὶ θυσίαι), concentrated in Hebrews.",
   "note": "マタ5:23-24、マタ8:4、マコ1:44、使7:42、ヨハ16:2、ヘブ5:1・3、ヘブ8:3、ヘブ9:14・25・28、ヘブ10:11-12、ヘブ11:4・17。"
  },
  {
   "id": "4",
   "label": "扱う・ふるまう（中動・受動）",
   "label_en": "to treat / deal with (middle / passive)",
   "label_es": "tratar / portarse con (voz media / pasiva)",
   "def": "προσφέρεται として、人に対して「ふるまう」「扱う」の意で用いられる。",
   "def_en": "As προσφέρεται, used in the sense of \"behave toward\" or \"deal with\" a person.",
   "note": "ヘブ12:7。"
  }
 ],
