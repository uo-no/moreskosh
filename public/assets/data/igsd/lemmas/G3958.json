 "senses": [
  {
   "id": "1",
   "label": "苦しみを受ける・苦難にあう",
   "def": "迫害・不正・痛み・苦難などを被ること。信徒・使徒・一般の人が苦しみを受ける場合。πάσχειν ὑπέρ〜、πολλὰ παθεῖν、οὐδὲν κακὸν παθεῖν など。"
  },
  {
   "id": "2",
   "label": "受難（メシア・キリストが苦しみを受ける）",
   "def": "キリスト・人の子・メシアについて、πολλὰ παθεῖν（多くの苦しみを受ける）、δεῖ παθεῖν（苦しみを受けねばならない）などの形で述べられる用法。"
  },
  {
   "id": "3",
   "label": "病んで苦しむ",
   "def": "マタ17:15 の κακῶς πάσχει。病の状態で苦しむことを述べる。"
  },
  {
   "id": "4",
   "label": "（恵み・良いことを）経験する",
   "def": "良いこと・恵みを経験すること。ガラ3:4 のみ。"
  }
 ],
