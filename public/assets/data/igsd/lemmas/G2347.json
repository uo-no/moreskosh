 "senses": [
  {
   "id": "1",
   "label": "苦難・患難",
   "def": "迫害・窮乏・困難など、人が外から受ける圧迫や苦しみ。信じる者が耐え忍ぶ苦難として最も多く現れる。"
  },
  {
   "id": "2",
   "label": "終末の大患難",
   "def": "終わりの日に先立つ、前例のない大きな苦難。「大いなる患難」と呼ばれる用例。"
  },
  {
   "id": "3",
   "label": "心身の苦痛・悲痛",
   "def": "産みの苦しみや心の締めつけなど、人の内側で感じられる痛みや悲しみ。"
  }
 ],
