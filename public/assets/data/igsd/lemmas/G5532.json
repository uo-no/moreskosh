 "status": "final",
 "updated": "2026-11-24",
 "senses": [
  {
   "id": "1",
   "label": "必要とする（χρείαν ἔχειν）",
   "label_en": "to have need (χρείαν ἔχειν)",
   "label_es": "tener necesidad (χρείαν ἔχειν)",
   "def": "χρείαν ἔχειν の形で、あるものを「必要とする」「必要がある」ことを述べる。属格・不定詞・ἵνα 節と結びつく。否定で「必要がない」。",
   "def_en": "In the form χρείαν ἔχειν, states that one \"needs\" or \"has need of\" something. Combined with the genitive, an infinitive, and ἵνα clauses. Negated: \"has no need\".",
   "note": "マタ9:12、マタ21:3、マコ2:25、ヨハ13:10、コリ一12:21、テサ一4:9、ヘブ5:12、ヨハ一2:27、黙21:23。"
  },
  {
   "id": "2",
   "label": "必要・不足・困窮",
   "label_en": "need / lack / want",
   "label_es": "necesidad / carencia / escasez",
   "def": "満たされるべき必要、足りないもの、困窮そのものを名詞として指す。",
   "def_en": "A need that is to be met, what is lacking, and want itself, referred to as a noun.",
   "note": "ルカ10:42、使20:34、使28:10、ロマ12:13、エペ4:29、ピリ2:25、ピリ4:16・19、テト3:14、ヘブ7:11。"
  },
  {
   "id": "3",
   "label": "用務・役目",
   "label_en": "duty / task",
   "label_es": "deber / tarea",
   "def": "任じられる用向き・務めを指す。",
   "def_en": "Refers to an errand or duty assigned.",
   "note": "使6:3（ἐπὶ τῆς χρείας ταύτης）。"
  }
 ],
