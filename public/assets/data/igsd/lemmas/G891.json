{
 "lemma": "ἄχρι",
 "lemmaId": "grc:G891",
 "strong": "G891",
 "status": "final",
 "updated": "2026-11-24",
 "senses": [
  {
   "id": "1",
   "label": "〜まで（時の終点）",
   "label_en": "until (end point in time)",
   "label_es": "hasta (punto final en el tiempo)",
   "def": "属格を伴い、時間の終点を述べる前置詞。「この日に至るまで」「終わりまで」などの形で現れる。",
   "def_en": "A preposition with the genitive marking an end point in time. Appears in forms such as \"until this day\" and \"until the end\".",
   "note": "ルカ4:13、使2:29、使23:1、使26:22、ロマ8:22、コリ二3:14、ピリ1:5-6、黙2:26。"
  },
  {
   "id": "2",
   "label": "〜するときまで（接続詞的）",
   "label_en": "until (conjunctive: until the time when)",
   "label_es": "hasta que (conjuntivo: hasta el tiempo en que)",
   "def": "οὗ・ἧς ἡμέρας などに続く節をともない、ある出来事が起こるときまで、と述べる接続詞的用法。",
   "def_en": "A conjunctive use, with a clause following οὗ, ἧς ἡμέρας and the like: until the time when something happens.",
   "note": "マタ24:38、ルカ1:20、ルカ21:24、使7:18、ロマ11:25、コリ一11:26、コリ一15:25、黙7:3、黙20:3・5。"
  },
  {
   "id": "3",
   "label": "〜に至るまで（場所・程度の終点）",
   "label_en": "as far as (end point of place / degree)",
   "label_es": "hasta (punto final de lugar / grado)",
   "def": "場所の到達点、あるいは程度の限度（「死に至るまで」）を述べる前置詞。",
   "def_en": "A preposition marking the end point of place, or the limit of degree (\"even to death\").",
   "note": "マコ16:8、使11:5、使13:6、使22:4、使28:15、コリ二10:13-14、ヘブ4:12、黙2:10、黙12:11、黙18:5。"
  }
 ],
