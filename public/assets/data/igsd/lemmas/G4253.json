 "updated": "2026-11-24",
 "senses": [
  {
   "id": "1",
   "label": "〜より前に（時間的先行）",
   "def": "時間・順序の上で、あるものよりも先であることを述べる前置詞（属格支配）。πρὸ τοῦ ＋不定詞、πρὸ καταβολῆς κόσμου、πρὸ ἐμοῦ（私より前の者）などの形で現れる。",
   "note": "マタ6:8、ヨハ1:48、ヨハ17:5・24、ヨハ12:1、コリ一2:7、エペ1:4、ガラ3:23、テト1:2、ペテ一1:20。"
  },
  {
   "id": "2",
   "label": "〜の前に（空間的位置）",
   "def": "場所の上で、あるものの前に位置することを述べる。",
   "note": "使12:6、使12:14、使14:13、ヤコ5:9。"
  },
  {
   "id": "3",
   "label": "〜の前に先立って（πρὸ προσώπου）",
   "def": "使者・先駆けが、人の「顔の前に」送られる・先に行く、という定型表現。",
   "note": "マタ11:10、マコ1:2、ルカ7:27、ルカ9:52、ルカ10:1、使13:24。"
  },
  {
   "id": "4",
   "label": "何にもまさって（πρὸ πάντων）",
   "def": "πρὸ πάντων の形で、順位の上で何よりも優先すべきことを述べる。",
   "note": "ヤコ5:12、ペテ一4:8。"
  }
 ],
